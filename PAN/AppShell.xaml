<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PAN.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PAN.Views"
    FlyoutBehavior="Flyout">

    <FlyoutItem Title="Accueil" Route="home">
        <ShellContent
            Title="Accueil"
            ContentTemplate="{DataTemplate views:HomePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Observations">
        <ShellContent
            Title="Ajouter une observation"
            Route="newEvent"
            ContentTemplate="{DataTemplate views:NewEventPage}" />

        <ShellContent
            Title="Rechercher"
            Route="search"
            ContentTemplate="{DataTemplate views:SearchPage}" />
    </FlyoutItem>

    <FlyoutItem Title="GEIPAN">
        <ShellContent
            Title="Connexion"
            Route="login"
            ContentTemplate="{DataTemplate views:LoginPage}" />

        <ShellContent
            Title="Administration"
            Route="admin"
            ContentTemplate="{DataTemplate views:AdminPage}" />
    </FlyoutItem>

</Shell>
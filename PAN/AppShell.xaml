<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PAN.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PAN.Views"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="#081426"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.UnselectedColor="#93A0B4"
    Shell.TabBarBackgroundColor="#09182D"
    Shell.TabBarForegroundColor="#53D769"
    Shell.TabBarTitleColor="#53D769"
    Shell.TabBarUnselectedColor="#A8B4C7">

    <TabBar Route="main">

        <ShellContent
            Title="Accueil"
            Route="home"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent
            Title="Ajouter"
            Route="newEvent"
            Icon="add.png"
            ContentTemplate="{DataTemplate views:NewEventPage}" />

        <ShellContent
            Title="Recherche"
            Route="search"
            Icon="search.png"
            ContentTemplate="{DataTemplate views:SearchPage}" />

        <ShellContent
            Title="Profil"
            Route="login"
            Icon="user.png"
            ContentTemplate="{DataTemplate views:LoginPage}" />

    </TabBar>

    <ShellContent
        Route="admin"
        ContentTemplate="{DataTemplate views:AdminPage}" 
        FlyoutItemIsVisible="False" />
</Shell>
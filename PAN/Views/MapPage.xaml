<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAN.Views.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PAN.ViewModels"
    x:DataType="viewmodels:MapViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#020B18"
    Appearing="ContentPage_Appearing">

    <Grid>
        <Image Source="background_space.jpg" Aspect="AspectFill" Opacity="1" />
        <BoxView Color="#020B18" Opacity="0.42" />

        <Grid HorizontalOptions="Center" MaximumWidthRequest="430">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0" Padding="22,48,22,14" ColumnDefinitions="Auto,*">
                    <Button
                        Text="‹"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        Padding="0"
                        BackgroundColor="#09182D"
                        BorderColor="#1D385C"
                        BorderWidth="1"
                        TextColor="White"
                        FontSize="30"
                        Command="{Binding BackCommand}" />

                    <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" Spacing="2">
                        <Label Text="Carte"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label Text="Observations géolocalisées"
                               FontSize="14"
                               TextColor="#AEB9CA" />
                    </VerticalStackLayout>
                </Grid>

                <Frame
                    Grid.Row="1"
                    Margin="22,0,22,14"
                    CornerRadius="24"
                    Padding="0"
                    HasShadow="False"
                    BackgroundColor="#0A1B31"
                    BorderColor="#1D385C"
                    IsClippedToBounds="True">

                    <Grid RowDefinitions="*,Auto">
                        <WebView
                            Grid.Row="0"
                            x:Name="MapWebView"
                            Source="{Binding HtmlSource}" />

                        <Button
                            Grid.Row="1"
                            Text="Charger +20 observations"
                            Margin="12"
                            HeightRequest="46"
                            CornerRadius="18"
                            BackgroundColor="#52D765"
                            TextColor="White"
                            FontAttributes="Bold"
                            Command="{Binding LoadMoreCommand}" />
                    </Grid>
                </Frame>

                <Frame
                    Grid.Row="2"
                    Margin="18,0,18,14"
                    CornerRadius="18"
                    Padding="0"
                    HasShadow="False"
                    BackgroundColor="#09182D"
                    BorderColor="#1D385C">

                    <Grid ColumnDefinitions="*,*,64,*,*" Padding="10,8" ColumnSpacing="6">

                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToHomeCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="⌂" FontSize="21" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Accueil" FontSize="10" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="♢" FontSize="21" TextColor="#4ED464" HorizontalTextAlignment="Center" />
                            <Label Text="Carte" FontSize="10" TextColor="#4ED464" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="+"
                            Command="{Binding GoToNewEventCommand}"
                            WidthRequest="56"
                            HeightRequest="56"
                            CornerRadius="28"
                            BackgroundColor="#52D765"
                            TextColor="White"
                            FontSize="28"
                            FontAttributes="Bold"
                            Padding="0" />

                        <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSearchCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="⌕" FontSize="21" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Recherche" FontSize="10" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="♙" FontSize="21" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Profil" FontSize="10" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </Grid>
                </Frame>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAN.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:viewmodels="clr-namespace:PAN.ViewModels"
    x:DataType="viewmodels:AdminViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#020B18">

    <Grid>

        <Image
            Source="background_space.jpg"
            Aspect="AspectFill"
            Opacity="1" />

        <BoxView Color="#020B18" Opacity="0.42" />

        <Grid HorizontalOptions="Center" WidthRequest="430">
            <Grid RowDefinitions="*,Auto">

                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Padding="26,56,26,30" Spacing="22">

                        <!-- HEADER -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Button
                                Text="‹"
                                WidthRequest="44"
                                HeightRequest="44"
                                CornerRadius="22"
                                Padding="0"
                                BackgroundColor="#09182D"
                                BorderColor="#1D385C"
                                BorderWidth="1"
                                TextColor="White"
                                FontSize="30"
                                Command="{Binding BackCommand}" />

                            <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" Spacing="2">
                                <Label
                                    Text="Administration"
                                    FontSize="30"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Text="Statistiques des cas GEIPAN"
                                    FontSize="15"
                                    TextColor="#AEB9CA" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- TOTAL CARD -->
                        <Frame
                            CornerRadius="24"
                            Padding="20"
                            HasShadow="False"
                            BackgroundColor="#0A1B31"
                            BorderColor="#1D385C">

                            <Grid ColumnDefinitions="58,*,Auto">
                                <Frame
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    CornerRadius="25"
                                    Padding="0"
                                    HasShadow="False"
                                    BackgroundColor="#0F3A86">

                                    <Label
                                        Text="✦"
                                        FontSize="24"
                                        TextColor="White"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label
                                        Text="Total des cas"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#AEB9CA" />

                                    <Label
                                        Text="Observations recensées"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="White" />
                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="2"
                                    Text="{Binding TotalCases}"
                                    FontSize="34"
                                    FontAttributes="Bold"
                                    TextColor="#4ED464"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </Frame>

                        <!-- CHART CARD -->
                        <Frame
                            CornerRadius="24"
                            Padding="18"
                            HasShadow="False"
                            BackgroundColor="#0A1B31"
                            BorderColor="#1D385C">

                            <VerticalStackLayout Spacing="16">

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Text="Répartition"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="White" />

                                        <Label
                                            Text="Classifications des phénomènes"
                                            FontSize="14"
                                            TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="PAN"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#4ED464"
                                        VerticalTextAlignment="Center" />
                                </Grid>

                                <Frame
                                    CornerRadius="18"
                                    Padding="10"
                                    HasShadow="False"
                                    BackgroundColor="#07172A"
                                    BorderColor="#1D385C">

                                    <lvc:PieChart
                                        Series="{Binding Series}"
                                        LegendPosition="Bottom"
                                        HeightRequest="360"
                                        BackgroundColor="Transparent" />
                                </Frame>

                            </VerticalStackLayout>
                        </Frame>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- NAV CUSTOM -->
                <Frame
                    Grid.Row="1"
                    Margin="20,0,20,16"
                    CornerRadius="18"
                    Padding="0"
                    HasShadow="False"
                    BackgroundColor="#09182D"
                    BorderColor="#1D385C">

                    <Grid ColumnDefinitions="*,*,Auto,*,*" Padding="12,10" ColumnSpacing="10">

                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToHomeCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="⌂" FontSize="26" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Accueil" FontSize="13" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Label Text="♢" FontSize="26" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Carte" FontSize="13" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="+"
                            Command="{Binding GoToNewEventCommand}"
                            WidthRequest="68"
                            HeightRequest="68"
                            CornerRadius="34"
                            BackgroundColor="#52D765"
                            TextColor="White"
                            FontSize="34"
                            FontAttributes="Bold"
                            Padding="0" />

                        <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSearchCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="⌕" FontSize="26" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Rechercher" FontSize="13" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="♙" FontSize="26" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Profil" FontSize="13" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </Grid>
                </Frame>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>
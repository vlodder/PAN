<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:viewmodels="clr-namespace:PAN.ViewModels"
             x:Class="PAN.Views.AdminPage"
             x:DataType="viewmodels:AdminViewModel"
             Title="Tableau de bord">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="20,30,20,40">

            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="Administration" 
                       FontSize="14" 
                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" 
                       TextTransform="Uppercase" 
                       CharacterSpacing="1.5" 
                       HorizontalOptions="Center" />
                <Label Text="Statistiques des cas GEIPAN" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F2937}"
                    HorizontalOptions="Fill"
                    Margin="10,0">

                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="{AppThemeBinding Light=0.08, Dark=0.3}" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto, *" Padding="24">

                    <FlexLayout Grid.Row="0" 
                                JustifyContent="SpaceBetween" 
                                AlignItems="Center" 
                                Margin="0,0,0,20">

                        <Label Text="Répartition des classifications" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />

                        <VerticalStackLayout HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="TOTAL DES CAS" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" 
                                   HorizontalOptions="End" />
                            <Label Text="{Binding TotalCases}" 
                                   FontSize="32" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}" 
                                   HorizontalOptions="End" 
                                   Margin="0,-5,0,0"/>
                        </VerticalStackLayout>
                    </FlexLayout>

                    <lvc:PieChart Grid.Row="1"
                                  Series="{Binding Series}" 
                                  LegendPosition="Right"
                                  HeightRequest="450"
                                  BackgroundColor="Transparent"
                                  LegendTextPaint="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
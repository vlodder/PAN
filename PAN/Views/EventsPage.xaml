<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PAN.Views.EventsPage"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/maui/global/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="EventsViewModel"
    ControlTemplate="{StaticResource VersionTemplate}"
    Title="{x:Bind Heading}"
    mc:Ignorable="d">
    <ContentPage.Content>
        <StackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Label Text="You don't have anything scheduled today." />
            <Button
                Command="{x:Bind AddEventCommand}"
                HorizontalOptions="Center"
                Style="{StaticResource PrimaryAction}"
                Text="Add Event" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>

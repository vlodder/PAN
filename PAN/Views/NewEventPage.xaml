<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAN.Views.NewEventPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PAN.ViewModels"
    x:DataType="viewmodels:NewEventViewModel"
    Title="{Binding TitrePage}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label 
                Text="{Binding TitrePage}"
                FontSize="24"
                FontAttributes="Bold" />

            <VerticalStackLayout Spacing="10">

                <DatePicker 
                    Date="{Binding DateObservation}" 
                    Format="dd/MM/yyyy" />

                <Picker 
                    Title="Ville"
                    ItemsSource="{Binding Villes}"
                    SelectedItem="{Binding SelectedVille}" />

                <Picker 
                    Title="Type"
                    ItemsSource="{Binding Types}"
                    ItemDisplayBinding="{Binding Nom}"
                    SelectedItem="{Binding SelectedType}" />

                <Picker 
                    Title="Cas (Classification)"
                    ItemsSource="{Binding Classements}"
                    ItemDisplayBinding="{Binding Nom}"
                    SelectedItem="{Binding SelectedClassement}"
                    IsVisible="{Binding IsEditMode}" />

                <Entry 
                    Placeholder="Latitude (Optionnel)"
                    Text="{Binding Latitude}" 
                    Keyboard="Numeric" />

                <Entry 
                    Placeholder="Longitude (Optionnel)"
                    Text="{Binding Longitude}" 
                    Keyboard="Numeric" />

                <HorizontalStackLayout Spacing="15" VerticalOptions="Center" Margin="5,0">
                    <Label Text="Phénomène mouvant" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding EstMouvant}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Editor 
                    Placeholder="Description du témoin..."
                    Text="{Binding Descriptif}" 
                    HeightRequest="150" />

                <Editor 
                    Placeholder="Compte rendu officiel de l'enquête..."
                    Text="{Binding CompteRendu}" 
                    HeightRequest="150"
                    IsVisible="{Binding IsEditMode}" />

                <Button 
                    Text="Enregistrer l'observation"
                    Command="{Binding SaveCommand}"
                    Margin="0,15,0,0" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
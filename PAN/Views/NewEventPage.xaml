<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAN.Views.NewEventPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PAN.ViewModels"
    x:DataType="viewmodels:NewEventViewModel"
    Title="Nouvelle observation">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Ajouter une observation"
                FontSize="24"
                FontAttributes="Bold" />

            <DatePicker
                Date="{Binding DateObservation}" />

            <Editor
                Placeholder="Décrivez ce que vous avez observé"
                AutoSize="TextChanges"
                HeightRequest="120"
                Text="{Binding Descriptif}" />

            <Entry
                Placeholder="Ville"
                Text="{Binding Ville}" />

            <HorizontalStackLayout Spacing="10">
                <Label
                    Text="Phénomène mouvant"
                    VerticalOptions="Center" />
                <Switch IsToggled="{Binding EstMouvant}" />
            </HorizontalStackLayout>

            <Picker
                Title="Type d'observation"
                ItemsSource="{Binding Types}"
                SelectedItem="{Binding TypeSelectionne}" />

            <Button
                Text="Enregistrer"
                Command="{Binding SaveCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAN.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PAN.ViewModels"
    x:DataType="viewmodels:HomeViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#020B18">

    <Grid>

        <Image
            Source="background_space.jpg"
            Aspect="AspectFill"
            Opacity="1" />

        <BoxView Color="#020B18" Opacity="0.25" />

        <Grid
            HorizontalOptions="Center"
            WidthRequest="430">

            <Grid RowDefinitions="*,Auto">

                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Padding="26,28,26,30" Spacing="24">

                      

                        <!-- LOGO -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,34,0,0">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="☾✦" FontSize="34" TextColor="White" />
                                <Label
                                    Text="geipan"
                                    FontSize="38"
                                    FontAttributes="Bold"
                                    TextColor="White" />
                            </HorizontalStackLayout>

                            <Grid Grid.Column="1">
                                <Label
                                    Text="♡"
                                    FontSize="34"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                                <Frame
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    CornerRadius="10"
                                    Padding="0"
                                    BackgroundColor="#35C85A"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start">
                                    <Label
                                        Text="3"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />
                                </Frame>
                            </Grid>
                        </Grid>

                        <!-- HERO -->
                        <Grid HeightRequest="220">
                            <Image
                                Source="ufo_overlay.png"
                                Aspect="AspectFit"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                WidthRequest="180"
                                Opacity="0.95" />
                        </Grid>

                        <VerticalStackLayout Spacing="6" Margin="0,-40,0,0">
                            <Label
                                Text="Bienvenue"
                                FontSize="34"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <HorizontalStackLayout Spacing="8">
                                <Label
                                    Text="sur l’application"
                                    FontSize="30"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Text="GEIPAN"
                                    FontSize="30"
                                    FontAttributes="Bold"
                                    TextColor="#4ED464" />
                            </HorizontalStackLayout>

                            <Label
                                Text="Signalez, consultez et suivez les phénomènes aéronautiques non identifiés."
                                FontSize="18"
                                TextColor="#D6DEEA"
                                LineBreakMode="WordWrap"
                                Margin="0,12,0,0" />
                        </VerticalStackLayout>

                        <!-- CARDS -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,18,0,0">

                            <Frame
                                Grid.Column="0"
                                HeightRequest="160"
                                CornerRadius="18"
                                Padding="18"
                                HasShadow="False"
                                BackgroundColor="#48C765">

                                <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
                                    <Label Text="▣+" FontSize="30" TextColor="White" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label
                                            Text="Ajouter&#10;une observation"
                                            FontSize="19"
                                            FontAttributes="Bold"
                                            TextColor="White" />

                                        <Label
                                            Text="Déclarez un phénomène que vous avez observé"
                                            FontSize="13"
                                            TextColor="White" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Text="›"
                                        Command="{Binding GoToNewEventCommand}"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        CornerRadius="24"
                                        BackgroundColor="#0C5528"
                                        TextColor="White"
                                        FontSize="34"
                                        HorizontalOptions="End" />
                                </Grid>
                            </Frame>

                            <Frame
                                Grid.Column="1"
                                HeightRequest="160"
                                CornerRadius="18"
                                Padding="18"
                                HasShadow="False"
                                BackgroundColor="#143763">

                                <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
                                    <Label Text="⌕" FontSize="38" TextColor="White" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label
                                            Text="Rechercher&#10;des observations"
                                            FontSize="19"
                                            FontAttributes="Bold"
                                            TextColor="White" />

                                        <Label
                                            Text="Consultez les témoignages déjà référencés"
                                            FontSize="13"
                                            TextColor="#D6DEEA" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Text="›"
                                        Command="{Binding GoToSearchCommand}"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        CornerRadius="24"
                                        BackgroundColor="#07172A"
                                        TextColor="White"
                                        FontSize="34"
                                        HorizontalOptions="End" />
                                </Grid>
                            </Frame>
                        </Grid>

                        <!-- DERNIERES OBS -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                            <Label
                                Text="Dernières observations"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Grid.Column="1"
                                Text="Voir tout  ›"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#4ED464" />
                        </Grid>

                        <Frame
                            CornerRadius="18"
                            Padding="0"
                            HasShadow="False"
                            BackgroundColor="#0A1B31"
                            BorderColor="#1D385C">

                            <VerticalStackLayout Spacing="0">

                                <Grid Padding="16" ColumnDefinitions="58,*,Auto,Auto">
                                    <Frame WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="#0F3A86">
                                        <Label Text="✧" FontSize="22" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Lumière brillante dans le ciel" FontSize="17" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="⌖ Toulouse (31)   ◔ 28 avr. 2026 à 22:15" FontSize="13" TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="↑ 12" FontSize="16" FontAttributes="Bold" TextColor="#4ED464" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="›" FontSize="30" TextColor="#AEB9CA" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#1D385C" />

                                <Grid Padding="16" ColumnDefinitions="58,*,Auto,Auto">
                                    <Frame WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="#6131A3">
                                        <Label Text="●●●" FontSize="14" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Objet sombre triangulaire" FontSize="17" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="⌖ Annecy (74)   ◔ 26 avr. 2026 à 20:03" FontSize="13" TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="↑ 15" FontSize="16" FontAttributes="Bold" TextColor="#4ED464" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="›" FontSize="30" TextColor="#AEB9CA" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#1D385C" />

                                <Grid Padding="16" ColumnDefinitions="58,*,Auto,Auto">
                                    <Frame WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="#087778">
                                        <Label Text="☁" FontSize="22" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Plusieurs lumières immobiles" FontSize="17" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="⌖ Nantes (44)   ◔ 27 avr. 2026 à 21:47" FontSize="13" TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="↑ 8" FontSize="16" FontAttributes="Bold" TextColor="#4ED464" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="›" FontSize="30" TextColor="#AEB9CA" VerticalTextAlignment="Center" />
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>

                        <!-- INFO -->
                        <Frame
                            CornerRadius="18"
                            Padding="20"
                            HasShadow="False"
                            BackgroundColor="#0A1B31"
                            BorderColor="#1D385C">

                            <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
                                <Label
                                    Text="ⓘ"
                                    FontSize="46"
                                    TextColor="#5D9BFF"
                                    VerticalTextAlignment="Center" />

                                <VerticalStackLayout Grid.Column="1" Spacing="8">
                                    <Label
                                        Text="Le saviez-vous ?"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label
                                        Text="La majorité des PAN ont une explication rationnelle. Votre témoignage peut aider à mieux comprendre !"
                                        FontSize="16"
                                        TextColor="#C4CEDD" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- NAV CUSTOM MOBILE -->
                <Frame
                    Grid.Row="1"
                    Margin="20,0,20,16"
                    CornerRadius="18"
                    Padding="0"
                    HasShadow="False"
                    BackgroundColor="#09182D"
                    BorderColor="#1D385C">

                    <Grid ColumnDefinitions="*,*,Auto,*,*" Padding="12,10" ColumnSpacing="10">

                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <Label Text="⌂" FontSize="26" TextColor="#4ED464" HorizontalTextAlignment="Center" />
                            <Label Text="Accueil" FontSize="13" TextColor="#4ED464" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Label Text="♢" FontSize="26" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Carte" FontSize="13" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="+"
                            Command="{Binding GoToNewEventCommand}"
                            WidthRequest="68"
                            HeightRequest="68"
                            CornerRadius="34"
                            BackgroundColor="#52D765"
                            TextColor="White"
                            FontSize="34"
                            FontAttributes="Bold" />

                        <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSearchCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="⌕" FontSize="26" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Rechercher" FontSize="13" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="♙" FontSize="26" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            <Label Text="Profil" FontSize="13" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </Grid>
                </Frame>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
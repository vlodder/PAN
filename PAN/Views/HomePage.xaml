<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAN.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PAN.ViewModels"
    x:DataType="viewmodels:HomeViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#020B18"
    Padding="{OnPlatform Android='0,28,0,0', iOS='0,44,0,0'}">

    <Grid>

        <Image Source="background_space.jpg"
               Aspect="AspectFill"
               Opacity="0.85"
               InputTransparent="True" />

        <BoxView Color="#020B18"
                 Opacity="0.35"
                 InputTransparent="True" />

        <Grid HorizontalOptions="Center"
              MaximumWidthRequest="520">

            <Grid RowDefinitions="*,Auto">

                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Padding="18,18,18,24" Spacing="18">

                        <!-- LOGO -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="☾✦"
                                       FontSize="24"
                                       TextColor="White"
                                       VerticalTextAlignment="Center" />

                                <Label Text="geipan"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="1"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    BackgroundColor="#09182D"
                                    Stroke="#1D385C"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 17">

                                <Label Text="♡"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- HERO -->
                        <Grid HeightRequest="170">
                            <Image Source="ufo_overlay.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   WidthRequest="145"
                                   Opacity="0.95"
                                   InputTransparent="True" />

                            <VerticalStackLayout VerticalOptions="End" Spacing="4">
                                <Label Text="Bienvenue"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="White" />

                                <HorizontalStackLayout Spacing="7">
                                    <Label Text="sur"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="White" />

                                    <Label Text="GEIPAN"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#4ED464" />
                                </HorizontalStackLayout>

                                <Label Text="Signalez et consultez les observations."
                                       FontSize="13"
                                       TextColor="#D6DEEA"
                                       Margin="0,6,0,0" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- ACTIONS -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                            <Border Grid.Column="0"
                                    HeightRequest="118"
                                    Padding="12"
                                    BackgroundColor="#48C765"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToNewEventCommand}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Label Text="▣+"
                                           FontSize="20"
                                           TextColor="White" />

                                    <Label Grid.Row="1"
                                           Text="Ajouter une observation"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalOptions="Center" />

                                    <Border Grid.Row="2"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="#0C5528"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17"
                                            HorizontalOptions="End">

                                        <Label Text="›"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    HeightRequest="118"
                                    Padding="12"
                                    BackgroundColor="#143763"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToSearchCommand}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Label Text="⌕"
                                           FontSize="24"
                                           TextColor="White" />

                                    <Label Grid.Row="1"
                                           Text="Rechercher des observations"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalOptions="Center" />

                                    <Border Grid.Row="2"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="#07172A"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17"
                                            HorizontalOptions="End">

                                        <Label Text="›"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- DERNIERES OBS -->
                        <Label Text="Dernières observations"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="White"
                               Margin="0,2,0,0" />

                        <Border BackgroundColor="#0A1B31"
                                Stroke="#1D385C"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18">

                            <VerticalStackLayout Spacing="0">

                                <Grid Padding="12" ColumnDefinitions="42,*,Auto">
                                    <Border WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="#0F3A86"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17">
                                        <Label Text="✧"
                                               FontSize="18"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Lumière brillante"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                        <Label Text="Toulouse · 28 avr. 22:15"
                                               FontSize="10"
                                               TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="↑ 12"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#4ED464"
                                           VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#1D385C" />

                                <Grid Padding="12" ColumnDefinitions="42,*,Auto">
                                    <Border WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="#6131A3"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17">
                                        <Label Text="●●●"
                                               FontSize="9"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Objet triangulaire"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                        <Label Text="Annecy · 26 avr. 20:03"
                                               FontSize="10"
                                               TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="↑ 15"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#4ED464"
                                           VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#1D385C" />

                                <Grid Padding="12" ColumnDefinitions="42,*,Auto">
                                    <Border WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="#087778"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17">
                                        <Label Text="☁"
                                               FontSize="18"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Lumières immobiles"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                        <Label Text="Nantes · 27 avr. 21:47"
                                               FontSize="10"
                                               TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="↑ 8"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#4ED464"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- INFO -->
                        <Border Padding="14"
                                BackgroundColor="#0A1B31"
                                Stroke="#1D385C"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Margin="0,0,0,8">

                            <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                                <Label Text="ⓘ"
                                       FontSize="28"
                                       TextColor="#5D9BFF"
                                       VerticalTextAlignment="Center" />

                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Le saviez-vous ?"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="White" />

                                    <Label Text="La majorité des PAN ont une explication rationnelle."
                                           FontSize="12"
                                           TextColor="#C4CEDD" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- NAV CUSTOM MOBILE -->
                <Border Grid.Row="1"
                        Margin="16,0,16,12"
                        BackgroundColor="#09182D"
                        Stroke="#1D385C"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">

                    <Grid ColumnDefinitions="*,*,64,*,*" Padding="10,8" ColumnSpacing="6">

                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="⌂" FontSize="21" TextColor="#4ED464" HorizontalTextAlignment="Center" />
                            <Label Text="Accueil" FontSize="10" TextColor="#4ED464" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1" Padding="4" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToMapCommand}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="♢" FontSize="21" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                                <Label Text="Carte" FontSize="10" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Button Grid.Column="2"
                                Text="+"
                                Command="{Binding GoToNewEventCommand}"
                                WidthRequest="56"
                                HeightRequest="56"
                                CornerRadius="28"
                                BackgroundColor="#52D765"
                                TextColor="White"
                                FontSize="28"
                                FontAttributes="Bold"
                                Padding="0" />

                        <Border Grid.Column="3" Padding="4" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSearchCommand}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="⌕" FontSize="21" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                                <Label Text="Recherche" FontSize="10" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="4" Padding="4" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="♙" FontSize="21" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                                <Label Text="Profil" FontSize="10" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>
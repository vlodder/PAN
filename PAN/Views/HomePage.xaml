<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAN.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PAN.ViewModels"
    x:DataType="viewmodels:HomeViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#020B18">

    <Grid>

        <Image
            Source="background_space.jpg"
            Aspect="AspectFill"
            Opacity="0.85"
            InputTransparent="True" />

        <BoxView
            Color="#020B18"
            Opacity="0.35"
            InputTransparent="True" />

        <Grid
            HorizontalOptions="Center"
            MaximumWidthRequest="520">

            <Grid RowDefinitions="*,Auto">

                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Padding="26,58,26,30" Spacing="22">

                        <!-- LOGO -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="☾✦" FontSize="32" TextColor="White" />
                                <Label Text="geipan" FontSize="38" FontAttributes="Bold" TextColor="White" />
                            </HorizontalStackLayout>

                            <Border
                                Grid.Column="1"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="#09182D"
                                Stroke="#1D385C"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 21">

                                <Label
                                    Text="♡"
                                    FontSize="26"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- HERO -->
                        <Grid HeightRequest="210">
                            <Image
                                Source="ufo_overlay.png"
                                Aspect="AspectFit"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                WidthRequest="175"
                                Opacity="0.95"
                                InputTransparent="True" />

                            <VerticalStackLayout VerticalOptions="End" Spacing="6">
                                <Label
                                    Text="Bienvenue"
                                    FontSize="34"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <HorizontalStackLayout Spacing="8">
                                    <Label
                                        Text="sur"
                                        FontSize="30"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label
                                        Text="GEIPAN"
                                        FontSize="30"
                                        FontAttributes="Bold"
                                        TextColor="#4ED464" />
                                </HorizontalStackLayout>

                                <Label
                                    Text="Signalez et consultez les observations."
                                    FontSize="17"
                                    TextColor="#D6DEEA"
                                    Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- ACTIONS -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">

                            <Border
                                Grid.Column="0"
                                HeightRequest="150"
                                Padding="18"
                                BackgroundColor="#48C765"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToNewEventCommand}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Label Text="▣+" FontSize="30" TextColor="White" />

                                    <Label
                                        Grid.Row="1"
                                        Text="Ajouter une observation"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                    <Border
                                        Grid.Row="2"
                                        WidthRequest="46"
                                        HeightRequest="46"
                                        BackgroundColor="#0C5528"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 23"
                                        HorizontalOptions="End">

                                        <Label
                                            Text="›"
                                            FontSize="30"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                HeightRequest="150"
                                Padding="18"
                                BackgroundColor="#143763"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToSearchCommand}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Label Text="⌕" FontSize="36" TextColor="White" />

                                    <Label
                                        Grid.Row="1"
                                        Text="Rechercher des observations"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                    <Border
                                        Grid.Row="2"
                                        WidthRequest="46"
                                        HeightRequest="46"
                                        BackgroundColor="#07172A"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 23"
                                        HorizontalOptions="End">

                                        <Label
                                            Text="›"
                                            FontSize="30"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                        </Grid>

                        <!-- DERNIERES OBS -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label
                                Text="Dernières observations"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White" />

          
                        </Grid>

                        <Border
                            BackgroundColor="#0A1B31"
                            Stroke="#1D385C"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="0">

                                <Grid Padding="16" ColumnDefinitions="52,*,Auto">
                                    <Border
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        BackgroundColor="#0F3A86"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 21">

                                        <Label Text="✧" FontSize="22" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Lumière brillante" FontSize="17" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="Toulouse · 28 avr. 22:15" FontSize="13" TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="↑ 12" FontSize="16" FontAttributes="Bold" TextColor="#4ED464" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#1D385C" />

                                <Grid Padding="16" ColumnDefinitions="52,*,Auto">
                                    <Border
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        BackgroundColor="#6131A3"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 21">

                                        <Label Text="●●●" FontSize="13" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Objet triangulaire" FontSize="17" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="Annecy · 26 avr. 20:03" FontSize="13" TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="↑ 15" FontSize="16" FontAttributes="Bold" TextColor="#4ED464" VerticalTextAlignment="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#1D385C" />

                                <Grid Padding="16" ColumnDefinitions="52,*,Auto">
                                    <Border
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        BackgroundColor="#087778"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 21">

                                        <Label Text="☁" FontSize="22" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Lumières immobiles" FontSize="17" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="Nantes · 27 avr. 21:47" FontSize="13" TextColor="#AEB9CA" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="↑ 8" FontSize="16" FontAttributes="Bold" TextColor="#4ED464" VerticalTextAlignment="Center" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                        <!-- INFO -->
                        <Border
                            Padding="18"
                            BackgroundColor="#0A1B31"
                            Stroke="#1D385C"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20">

                            <Grid ColumnDefinitions="52,*" ColumnSpacing="14">
                                <Label
                                    Text="ⓘ"
                                    FontSize="38"
                                    TextColor="#5D9BFF"
                                    VerticalTextAlignment="Center" />

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label
                                        Text="Le saviez-vous ?"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label
                                        Text="La majorité des PAN ont une explication rationnelle."
                                        FontSize="15"
                                        TextColor="#C4CEDD" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- NAV CUSTOM MOBILE -->
                <Border
                    Grid.Row="1"
                    Margin="20,0,20,16"
                    Padding="0"
                    BackgroundColor="#09182D"
                    Stroke="#1D385C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">

                    <Grid ColumnDefinitions="*,*,72,*,*" Padding="12,10" ColumnSpacing="8">

                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <Label Text="⌂" FontSize="25" TextColor="#4ED464" HorizontalTextAlignment="Center" />
                            <Label Text="Accueil" FontSize="12" TextColor="#4ED464" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1" Padding="6" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToMapCommand}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="♢" FontSize="25" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                                <Label Text="Carte" FontSize="12" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Button
                            Grid.Column="2"
                            Text="+"
                            Command="{Binding GoToNewEventCommand}"
                            WidthRequest="64"
                            HeightRequest="64"
                            CornerRadius="32"
                            BackgroundColor="#52D765"
                            TextColor="White"
                            FontSize="32"
                            FontAttributes="Bold"
                            Padding="0" />

                        <Border Grid.Column="3" Padding="6" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSearchCommand}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="⌕" FontSize="25" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                                <Label Text="Recherche" FontSize="12" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="4" Padding="6" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="♙" FontSize="25" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                                <Label Text="Profil" FontSize="12" TextColor="#AEB9CA" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
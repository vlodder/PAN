<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAN.Views.EventDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PAN.ViewModels"
    x:DataType="viewmodels:EventDetailViewModel"
    Title="Détail observation"
    BackgroundColor="#0B1020">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="Fiche observation"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White" />

            <Border
                BackgroundColor="#151C32"
                Stroke="#26324F"
                StrokeShape="RoundRectangle 18"
                Padding="18">

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Evenement.Ville}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding Evenement.CodePostal, StringFormat='Code postal : {0}'}" TextColor="#9AA7C2" />
                    <Label Text="{Binding Evenement.TypeNom, StringFormat='Type : {0}'}" TextColor="#9AA7C2" />
                    <Label Text="{Binding MouvantText, StringFormat='Mouvant : {0}'}" TextColor="#9AA7C2" />
                    <Label Text="{Binding Evenement.DateHeureObservation, StringFormat='Date : {0:dd/MM/yyyy HH:mm}'}" TextColor="#9AA7C2" />
                    <Label Text="{Binding Evenement.UpVote, StringFormat='Upvotes : {0}'}" TextColor="#5BE37D" FontAttributes="Bold" />

                    <BoxView HeightRequest="1" Color="#26324F" />

                    <Label Text="Description" TextColor="White" FontAttributes="Bold" />
                    <Label Text="{Binding Evenement.Descriptif}" TextColor="#DDE6FF" />
                </VerticalStackLayout>
            </Border>

            <Border
    IsVisible="{Binding HasCoordinates}"
    BackgroundColor="#151C32"
    Stroke="#26324F"
    StrokeShape="RoundRectangle 18"
    Padding="12">

                <VerticalStackLayout Spacing="12">

                    <Label
            Text="Localisation GPS"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="White" />

                    <ContentView
    x:Name="MapHost"
    HeightRequest="350" />

                    <Button
            Text="Ouvrir dans OpenStreetMap"
            Command="{Binding OpenExternalMapCommand}"
            BackgroundColor="#4CAF50"
            TextColor="White"
            CornerRadius="12"
            HeightRequest="44" />

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Aucune coordonnée GPS disponible."
                TextColor="#FFB84D"
                IsVisible="{Binding HasNoCoordinates}" />

            <Button
                Text="Upvote"
                Command="{Binding UpVoteCommand}"
                BackgroundColor="#4CAF50"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="48" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PAN.ViewModels"
             x:Class="PAN.Views.EditEventPage"
             x:DataType="viewmodels:EditEventViewModel"
             Title="Modifier l'événement"
             Shell.PresentationMode="ModalAnimated">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="20">

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}"
                                   Scale="1.2" />

                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Descriptif"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                        <Editor Text="{Binding Evenement.Descriptif}"
                                Placeholder="Descriptif de l'événement"
                                HeightRequest="100"
                                MaxLength="500"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                                PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#4B5563}"
                                BorderWidth="1"
                                CornerRadius="8"
                                Padding="12" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Date et heure d'observation"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                        <DatePicker Date="{Binding Evenement.DateHeureObservation}"
                                    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                    TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                        <TimePicker Time="{Binding Evenement.DateHeureObservation}"
                                    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                    TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Classification"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                        <Picker ItemsSource="{Binding Classements}"
                                ItemDisplayBinding="{Binding Nom}"
                                SelectedItem="{Binding Evenement.IdClassementNavigation}"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                                Title="Sélectionner une classification" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Type"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                        <Picker ItemsSource="{Binding Types}"
                                ItemDisplayBinding="{Binding Nom}"
                                SelectedItem="{Binding Evenement.IdTypeNavigation}"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                                Title="Sélectionner un type" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Phénomène"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                        <Picker ItemsSource="{Binding Phenomenes}"
                                ItemDisplayBinding="{Binding Nom}"
                                SelectedItem="{Binding Evenement.IdPhenomeneNavigation}"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                                Title="Sélectionner un phénomène" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Compte rendu"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                        <Editor Text="{Binding Evenement.CompteRendu}"
                                Placeholder="Compte rendu détaillé"
                                HeightRequest="150"
                                MaxLength="2000"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                                PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#4B5563}"
                                BorderWidth="1"
                                CornerRadius="8"
                                Padding="12" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="FillAndExpand">
                            <Label Text="Latitude"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                            <Entry Text="{Binding Evenement.Latitude}"
                                   Placeholder="Latitude"
                                   Keyboard="Numeric"
                                   BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                                   PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                   BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#4B5563}"
                                   BorderWidth="1"
                                   CornerRadius="8"
                                   Padding="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="FillAndExpand">
                            <Label Text="Longitude"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                            <Entry Text="{Binding Evenement.Longitude}"
                                   Placeholder="Longitude"
                                   Keyboard="Numeric"
                                   BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                                   PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                   BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#4B5563}"
                                   BorderWidth="1"
                                   CornerRadius="8"
                                   Padding="12" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Objet mouvant"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                        <CheckBox IsChecked="{Binding Evenement.Estmouvant}"
                                  Color="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="12" Margin="0,20,0,0">
                        <Button Text="Enregistrer"
                                Padding="16,12"
                                FontSize="14"
                                FontAttributes="Bold"
                                BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}"
                                TextColor="White"
                                CornerRadius="8"
                                Command="{Binding SaveCommand}"
                                HorizontalOptions="FillAndExpand" />

                        <Button Text="Annuler"
                                Padding="16,12"
                                FontSize="14"
                                FontAttributes="Bold"
                                BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#4B5563}"
                                TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                                CornerRadius="8"
                                Command="{Binding CancelCommand}"
                                HorizontalOptions="FillAndExpand" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>
<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PAN.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/maui/global/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Shell.NavBarIsVisible="False"
    x:DataType="LoginViewModel"
    mc:Ignorable="d">
    <ContentPage.Content>
        <StackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="20">
            
            <Label Text="Accès GEIPAN" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
            
            <Entry Placeholder="Mot de passe"
                   IsPassword="True"
                   Text="{Binding Password, Mode=TwoWay}"
                   WidthRequest="250" />

            <Button
                Command="{x:Bind LoginCommand}"
                Style="{StaticResource PrimaryAction}"
                Text="Connexion" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
